# Template only — copy to .env (gitignored) and fill in real values there.
# NEVER put a real key in this file: .env.example IS committed to git.
# Supabase is not in use yet (the routine currently reads recipients from Gmail).
# Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# service_role key — bypasses RLS. Belongs only in .env or a real secret store,
# never in .env.example and never in a field described as "visible to anyone".
SUPABASE_SERVICE_ROLE_KEY=
