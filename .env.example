# Template only — copy to .env (gitignored) and fill in real values there.
# NEVER put real keys in this file: .env.example IS committed to git.
#
# Same set goes in the routine's environment box (EMAIL_HASH_PEPPER optional —
# only if the routine checks membership). Never a service_role key or DB
# password in either place.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Project Settings → API keys → publishable. Safe to expose; RLS limits it to
# SELECT of email_hash, email_enc, created_at and permits no writes.
SUPABASE_PUBLISHABLE_KEY=

# Fernet key — decrypts email_enc to build the send list. Secret.
EMAIL_ENC_KEY=

# HMAC key — for email_hash membership checks. Secret. Optional for the routine.
EMAIL_HASH_PEPPER=
